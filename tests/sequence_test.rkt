#lang racket/base
(require rackunit racket/list "../mdl/parser.rkt" "../mdl/compiler.rkt"
         "../mdl/runtime/core.rkt")

(define-namespace-anchor anchor)
(define test-namespace (namespace-anchor->namespace anchor))
(define (run source)
  (parameterize ([current-namespace test-namespace]
                 [current-mdl-globals (make-hash)])
    (for/fold ([result #f]) ([expr (in-list (compile-program (parse-mdl source)))])
      (eval expr))))

(check-equal? (run "<SETG L (1 2 3)> <PUT <REST ,L> 1 9> <NTH ,L 2>") 9)
(check-equal? (run "<SETG L (1 2 3)> <PUTREST <REST ,L> (8)> <NTH ,L 3>") 8)
(check-eq? (run "<SETG L (1 2 3)> <==? ,L <PUT ,L 2 9>>") (mdl-atom "T"))
(check-eq? (run "<SETG L (1 2 3)> <==? <REST ,L> <REST ,L>>") (mdl-atom "T"))
(check-eq? (run "<SETG L (1 2 3)> <==? ,L <REST ,L 0>>") (mdl-atom "T"))
(check-equal? (run "<LENGTH (1 2 3)>") 3)
(check-equal? (run "<NTH (1 2 3) 2>") 2)
(check-equal? (run "<SETG V [1 2 3]> <PUT <REST ,V> 1 9> <NTH ,V 2>") 9)
(check-eq? (run "<SETG V [1 2 3]> <==? <REST ,V> <REST ,V>>") (mdl-atom "T"))
(check-eq? (run "<SETG V [1 2 3]> <==? ,V <REST ,V 0>>") (mdl-atom "T"))
(check-equal? (run "<SETG U ![1 2 3!]> <PUT <REST ,U> 1 9> <NTH ,U 2>") 9)
(check-eq? (run "<TYPE ![1 2!]>") (mdl-atom "UVECTOR"))
(check-eq? (run "<UTYPE ![1 2!]>") (mdl-atom "FIX"))
(check-eq? (run "<DEFINE F () '(1 2)> <==? <F> <F>>") (mdl-atom "T"))
(check-equal? (run "<SETG L '(1 2)> <PUT ,L 1 9> <NTH ,L 1>") 9)
(check-eq? (run "<TYPE <REST #FALSE (1 2)>>") (mdl-atom "LIST"))
(check-equal? (mdl-false-payload
               (run "<SETG F #FALSE (1 2)> <PUT ,F 2 9> ,F")) '(1 9))
(check-eq? (run "<TYPE <NTH #FALSE (1 NIL) 2>>") (mdl-atom "ATOM"))
(check-exn #rx"out of range" (lambda () (run "<NTH (1) 2>")))
(check-exn #rx"out of range" (lambda () (run "<REST (1) 2>")))
(check-exn #rx"UVECTOR" (lambda () (run "<PUT ![1 2!] 1 \"bad\">")))
(check-exn #rx"UVECTOR" (lambda () (run "![1 \"bad\"!]")))
(check-exn #rx"unsupported" (lambda () (run "<REST \"abc\">")))

(for ([n (in-range 2 11)])
  (define values (range n))
  (define original (apply mdl-list values))
  (define tail (mdl-rest original))
  (check-eq? (mdl-put! tail 1 99) tail)
  (check-equal? (mdl-nth original 2) 99))
(displayln "mutable sequence and REST alias tests passed")
