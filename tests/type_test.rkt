#lang racket/base
(require rackunit "../mdl/parser.rkt" "../mdl/compiler.rkt"
         "../mdl/runtime/core.rkt")

(define-namespace-anchor anchor)
(define test-namespace (namespace-anchor->namespace anchor))
(define (run source)
  (parameterize ([current-namespace test-namespace]
                 [current-mdl-globals (make-hash)]
                 [current-mdl-atom-space (make-mdl-atom-space)])
    (for/fold ([result #f]) ([expr (in-list (compile-program (parse-mdl source)))])
      (eval expr))))
(define (name source) (mdl-atom-pname (run source)))

(check-equal? (name "<PRIMTYPE 1>") "WORD")
(check-equal? (name "<PRIMTYPE 1.0>") "WORD")
(check-equal? (name "<PRIMTYPE #FALSE (1)>") "LIST")
(check-equal? (name "<PRIMTYPE [1 2]>") "VECTOR")
(check-equal? (name "<TYPEPRIM FORM>") "LIST")
(check-equal? (name "<TYPEPRIM FIX>") "WORD")
(check-equal? (name "<TYPEPRIM OBLIST>") "UVECTOR")
(check-equal? (name "<NEWTYPE M1-BOX VECTOR> <TYPEPRIM M1-BOX>") "VECTOR")
(check-equal? (name "<NEWTYPE M1-BOX VECTOR> <TYPE <CHTYPE [1 2] M1-BOX>>") "M1-BOX")
(check-equal? (name "<NEWTYPE M1-BOX VECTOR> <PRIMTYPE <CHTYPE [1 2] M1-BOX>>") "VECTOR")
(check-equal? (run "<NEWTYPE M1-BOX VECTOR> <NTH <CHTYPE [1 2] M1-BOX> 2>") 2)
(check-equal? (run "<NEWTYPE M1-L LIST> <SETG V <CHTYPE (1 2 3) M1-L>> <PUT <REST ,V> 1 9> <NTH ,V 2>") 9)
(check-equal? (name "<NEWTYPE M1-L LIST> <TYPE <REST <CHTYPE (1 2) M1-L>>>") "LIST")
(check-equal? (run "<SETG F #FALSE (1 2)> <PUT <CHTYPE ,F LIST> 2 9> <NTH ,F 2>") 9)
(check-equal? (name "<NEWTYPE M1-U UVECTOR> <UTYPE <CHTYPE ![1 2!] M1-U>>") "FIX")
(check-equal? (name "<NEWTYPE M1-U UVECTOR> <TYPE <REST <CHTYPE ![1 2!] M1-U>>>") "UVECTOR")
(check-equal? (name "<NEWTYPE M1-T VECTOR> <==? <SETG V <CHTYPE [1 2] M1-T>> <CHTYPE ,V M1-T>>") "T")
(check-equal? (name "<NEWTYPE M1-T VECTOR> <SETG V [1 2]> <==? ,V <CHTYPE <CHTYPE ,V M1-T> VECTOR>>") "T")
(check-true (mdl-false? (run "<NEWTYPE M1-T VECTOR> <SETG V [1 2]> <==? ,V <CHTYPE ,V M1-T>>")))
(check-equal? (name "<SETG F #FALSE (1 2)> <==? ,F <CHTYPE <CHTYPE ,F LIST> FALSE>>") "T")
(check-equal? (run "<NEWTYPE M1-T VECTOR> <SETG V [1 2]> <SETG W <CHTYPE ,V M1-T>> <PUT <REST ,W> 1 9> <NTH ,V 2>") 9)
(check-exn #rx"primitive type mismatch" (lambda () (run "<CHTYPE [1 2] LIST>")))
(check-exn #rx"unsupported built-in TYPE conversion" (lambda () (run "<CHTYPE ![1 2!] OBLIST>")))
(check-exn #rx"unsupported built-in TYPE conversion" (lambda () (run "<CHTYPE (1 2) FORM>")))
(check-exn #rx"already exists" (lambda () (run "<NEWTYPE FIX VECTOR>")))
(check-exn #rx"unknown MDL TYPE" (lambda () (run "<TYPEPRIM M1-UNKNOWN>")))
(check-equal? (name "<NEWTYPE M1-W FIX> <TYPE <CHTYPE 1 M1-W>>") "M1-W")
(check-equal? (run "<NEWTYPE M1-W FIX> <CHTYPE <CHTYPE 1 M1-W> FIX>") 1)
(displayln "MDL type constructor tests passed")
