#lang racket/base
(require rackunit racket/list "../mdl/parser.rkt")

(define nodes
  (parse-mdl "; commentary\n<DEFINE PROB (NUM) <L=? <MOD <RANDOM> 100> .NUM>>\n#ROOM {\"WHOUS\" \"West of House\"}\n"))
(check-equal? (length nodes) 2)
(check-equal? (map mdl-node-kind nodes) '(form typed))
(check-equal? (mdl-node-line (car nodes)) 2)
(check-equal? (mdl-node-value (car (mdl-node-value (car nodes)))) "DEFINE")
(define typed (second nodes))
(check-equal? (car (mdl-node-value typed)) "#ROOM")
(check-equal? (mdl-node-kind (cdr (mdl-node-value typed))) 'brace)

(define extras (parse-mdl "'![1 2!] ,VALUE .NUM %<> !.ROOMS"))
(check-equal? (map mdl-node-kind extras) '(quote global local percent splice))
(define uvector (car (parse-mdl "![1 2!]")))
(check-equal? (mdl-node-kind uvector) 'uvector)
(check-equal? (map mdl-node-value (mdl-node-value uvector)) '("1" "2"))
(check-equal? (mdl-node-value (car (parse-mdl "![!]"))) '())
(check-equal? (map mdl-node-value
                   (mdl-node-value (car (parse-mdl "![1 2]"))))
              '("1" "2"))
(define computed-global (car (parse-mdl ",<CXFLAG .LEAVINGS>")))
(check-equal? (mdl-node-kind computed-global) 'global)
(check-equal? (mdl-node-kind (mdl-node-value computed-global)) 'form)
(define after-comment (parse-mdl ";\"multi\nline, with > and ]\"\n<FOO ;<BAR 1> BAZ>"))
(check-equal? (length after-comment) 1)
(check-equal? (mdl-node-line (car after-comment)) 3)
(check-equal? (map mdl-node-value (mdl-node-value (car after-comment))) '("FOO" "BAZ"))
(check-equal? (mdl-node-value (car (parse-mdl "\"a\\nb\""))) "anb")
(check-exn exn:fail? (lambda () (parse-mdl ";")))
(check-exn exn:fail? (lambda () (parse-mdl "<DEFINE X (A) <+ .A 1>")))
(check-exn exn:fail? (lambda () (parse-mdl "\"unterminated")))
(define false-node (car (parse-mdl "#FALSE (1 NIL)")))
(check-equal? (mdl-node-kind false-node) 'false)
(check-equal? (map mdl-node-value (mdl-node-value false-node)) '("1" "NIL"))
(check-equal? (length (parse-mdl "#FALSE (1 NIL)")) 1)
(define word-node (car (parse-mdl "#WORD *777777777777*")))
(check-equal? (length (parse-mdl "#WORD *777777777777*")) 1)
(check-equal? (mdl-node-kind word-node) 'typed)
(check-equal? (car (mdl-node-value word-node)) "#WORD")
(check-equal? (mdl-node-value (cdr (mdl-node-value word-node))) "*777777777777*")
(displayln "reader smoke tests passed")
