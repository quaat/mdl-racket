#lang racket/base
(require rackunit racket/file racket/path "../mdl/loader.rkt")

(define root (make-temporary-file "/tmp/mdl-loader-test~a" 'directory))
(define (put relative contents)
  (define path (build-path root relative))
  (make-directory* (path-only path))
  (call-with-output-file path #:exists 'truncate/replace
    (lambda (out) (display contents out))))
(define (status report) (hash-ref report 'status))
(define (failure report) (hash-ref report 'failure))

(dynamic-wind
 void
 (lambda ()
   (put "first.mud" "<SETG SHARED 4>\n<DEFINE PLUS-SHARED (X) <+ .X ,SHARED>>\n<DEFMAC TWICE ('X) <FORM + .X .X>>\n")
   (put "second.mud" "<SETG RESULT <PLUS-SHARED 3>>\n<SETG MACRO-RESULT <TWICE 5>>\n")
   (define session (make-mdl-session root))
   (check-equal? (status (mdl-session-load! session "first.mud")) "PASS")
   (check-equal? (status (mdl-session-load! session "second.mud")) "PASS")
   (check-equal? (mdl-session-global session "RESULT") 7)
   (check-equal? (mdl-session-global session "MACRO-RESULT") 10)
   (check-equal? (mdl-session-call session "PLUS-SHARED" 3) 7)
   (check-equal? (mdl-session-call session "TWICE" 5) 10)
   (put "interpreted.mud"
        "<DEFINE RAW-ID ('X) .X>\n<DEFMAC MAKE-DYNAMIC () <FORM DEFINE DYNAMIC-ID () 9>>\n<MAKE-DYNAMIC>\n")
   (check-equal? (status (mdl-session-load! session "interpreted.mud")) "PASS")
   (check-equal? (mdl-session-call session "RAW-ID" 7) 7)
   (check-equal? (mdl-session-call session "DYNAMIC-ID") 9)
   (check-equal? (status (mdl-session-load! session "second.mud")) "PASS")
   (check-equal? (mdl-session-global session "SHARED") 4)
   (define independent (make-mdl-session root))
   (check-equal? (status (mdl-session-load! independent "second.mud")) "FAIL")
   (check-exn exn:fail? (lambda () (mdl-session-global independent "SHARED")))

   (put "nested/outer.mud" "<SETG ORDER 1>\n<SETG FLOAD-RESULT <FLOAD \"child.mud\">>\n<SETG ORDER <+ ,ORDER 10>>\n")
   (put "nested/child.mud" "<SETG ORDER <+ ,ORDER 2>>\n")
   (define nested (mdl-session-load! session "nested/outer.mud"))
   (check-equal? (status nested) "PASS")
   (check-equal? (hash-ref nested 'completed_expressions) 4)
   (check-equal? (mdl-session-global session "ORDER") 13)
   (check-equal? (mdl-session-global session "FLOAD-RESULT") "DONE")
   (check-equal? (status (mdl-session-load! session "nested/outer.mud")) "PASS")
   (check-equal? (mdl-session-global session "ORDER") 13)
   (put "repeat.mud" "<SETG COUNT <+ ,COUNT 1>>\n")
   (put "repeat-entry.mud" "<SETG COUNT 0>\n<FLOAD \"repeat.mud\">\n<FLOAD \"repeat.mud\">\n")
   (check-equal? (status (mdl-session-load! session "repeat-entry.mud")) "PASS")
   (check-equal? (mdl-session-global session "COUNT") 2)

   (put "partial.mud" "<SETG PARTIAL 8>\n<UNSUPPORTED-OP>\n<SETG PARTIAL 99>\n")
   (define partial (mdl-session-load! session "partial.mud"))
   (check-equal? (status partial) "FAIL")
   (check-equal? (hash-ref partial 'completed_expressions) 1)
   (check-equal? (mdl-session-global session "PARTIAL") 8)
   (check-equal? (hash-ref (failure partial) 'stage) "execute")
   (check-equal? (hash-ref (failure partial) 'expression_index) 2)
   (check-equal? (hash-ref (failure partial) 'line) 2)
   (check-equal? (hash-ref (failure partial) 'column) 1)
   (check-equal? (hash-ref (failure partial) 'construct) "UNSUPPORTED-OP")

   (put "bad-compile.mud" "<SETG BEFORE 1>\n#DECL\n<SETG BEFORE 2>\n")
   (define bad-compile (mdl-session-load! session "bad-compile.mud"))
   (check-equal? (hash-ref (failure bad-compile) 'stage) "compile")
   (check-equal? (mdl-session-global session "BEFORE") 1)
   (check-equal? (hash-ref bad-compile 'completed_expressions) 1)
   (check-equal? (hash-ref (failure bad-compile) 'construct) "#DECL")
   (check-equal? (hash-ref (failure bad-compile) 'line) 2)

   (define missing (mdl-session-load! session "missing.mud"))
   (check-equal? (status missing) "FAIL")
   (check-equal? (hash-ref (failure missing) 'classification) "filesystem")
   (check-equal? (hash-ref (failure (mdl-session-load! session "../escape.mud"))
                 'classification) "security")
   (check-equal? (hash-ref (failure (mdl-session-load! session "nested/../first.mud"))
                 'classification) "security")
   (define outside (make-temporary-file "/tmp/mdl-loader-outside~a"))
   (make-file-or-directory-link outside (build-path root "link.mud"))
   (check-equal? (hash-ref (failure (mdl-session-load! session "link.mud"))
                 'classification) "security")
   (make-file-or-directory-link (path-only outside) (build-path root "out-dir"))
   (check-equal? (hash-ref (failure (mdl-session-load! session "out-dir/mdl-loader-outside"))
                 'classification) "security")
   (define secret-dir (make-temporary-file "/tmp/mdl-loader-secret~a" 'directory))
   (call-with-output-file (build-path secret-dir "secret.mud")
     (lambda (out) (display "<SETG ESCAPED 1>\n" out)))
   (make-file-or-directory-link secret-dir (build-path root "bridge"))
   (make-file-or-directory-link (build-path root "bridge" "secret.mud")
                                (build-path root "indirect-link.mud"))
   (check-equal? (hash-ref (failure (mdl-session-load! session "indirect-link.mud"))
                 'classification) "security")
   (check-exn exn:fail? (lambda () (mdl-session-global session "ESCAPED")))
   (delete-directory/files secret-dir)
   (delete-file outside)
   (put "sub/child.mud" "<SETG LINK-ORDER 17>\n")
   (put "child.mud" "<SETG LINK-ORDER 99>\n")
   (make-file-or-directory-link (build-path root "sub" "deep")
                                (build-path root "alias"))
   (make-directory* (build-path root "sub" "deep"))
   (make-file-or-directory-link "alias/../child.mud"
                                (build-path root "ordered-link.mud"))
   (check-equal? (status (mdl-session-load! session "ordered-link.mud")) "PASS")
   (check-equal? (mdl-session-global session "LINK-ORDER") 17)
   (make-file-or-directory-link "sub/deep/../../child.mud"
                                (build-path root "two-parents.mud"))
   (check-equal? (status (mdl-session-load! session "two-parents.mud")) "PASS")
   (check-equal? (mdl-session-global session "LINK-ORDER") 99)
   (put "cycle-a.mud" "<FLOAD \"cycle-b.mud\">\n")
   (put "cycle-b.mud" "<FLOAD \"cycle-a.mud\">\n")
   (define cycle (mdl-session-load! session "cycle-a.mud"))
   (check-equal? (status cycle) "FAIL")
   (check-equal? (hash-ref (failure cycle) 'classification) "cycle")
   (check-equal? (length (hash-ref (failure cycle) 'load_chain)) 3)

   (put "parse-bad.mud" "<SETG X 1\n")
   (check-equal? (hash-ref (failure (mdl-session-load! session "parse-bad.mud"))
                 'classification) "reader")
   (check-equal? (hash-ref (failure (mdl-session-load! session "parse-bad.mud"))
                 'line) 2)
   (put "parse-after-valid.mud" "<SETG READER-PREFIX 8>\n<SETG BROKEN 1\n")
   (define parse-after-valid (mdl-session-load! session "parse-after-valid.mud"))
   (check-equal? (hash-ref (failure parse-after-valid) 'classification) "reader")
   (check-equal? (hash-ref parse-after-valid 'completed_expressions) 1)
   (check-equal? (mdl-session-global session "READER-PREFIX") 8)
   (put "runtime-before-parse.mud" "<UNKNOWN-BEFORE-READER>\n<SETG BROKEN 1\n")
   (define runtime-before-parse (mdl-session-load! session "runtime-before-parse.mud"))
   (check-equal? (hash-ref (failure runtime-before-parse) 'classification) "runtime")
   (check-equal? (hash-ref (failure runtime-before-parse) 'expression_index) 1)
   (put "wrong-fload.mud" "<FLOAD 3>\n")
   (check-equal? (hash-ref (failure (mdl-session-load! session "wrong-fload.mud"))
                 'classification) "runtime")
   (displayln "loader tests passed"))
 (lambda () (delete-directory/files root)))
