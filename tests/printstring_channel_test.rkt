#lang racket/base
(require rackunit racket/file "../mdl/loader.rkt" "../mdl/runtime/core.rkt")
(define root (make-temporary-file "mdl-printstring~a" 'directory))
;; S13 part B (ADR-0050): the session writes only to its explicit port.
(define port (open-output-string))
(define s (make-mdl-session root #:output-port port))
(define out (mdl-session-global s "OUTCHAN"))
(define-values (written stray)
  (let ([sentinel (open-output-string)])
    (define n (parameterize ([current-output-port sentinel])
                (mdl-session-call s "PRINTSTRING" "abc" out 2)))
    (values n (get-output-string sentinel))))
(check-equal? written 2)
(check-equal? (get-output-string port) "ab")
(check-equal? stray "")
(check-exn #rx"output channel" (lambda ()
  (mdl-session-call s "PRINTSTRING" "abc" (mdl-session-global s "INCHAN"))))
(check-exn #rx"count" (lambda ()
  (mdl-session-call s "PRINTSTRING" "abc" out -1)))
(delete-directory/files root)
