#lang racket/base
(require rackunit racket/file "../mdl/loader.rkt")

(define root (make-temporary-file "mdl-random~a" 'directory))
(dynamic-wind
 void
 (lambda ()
   (define (fresh) (make-mdl-session root))
   (define default (fresh))
   (check-equal? (for/list ([i (in-range 3)]) (mdl-session-call default "RANDOM"))
                 '(-17002352646 -5008989035 3493507944))
   (define seeded (fresh))
   (check-equal? (mdl-session-call seeded "RANDOM" 1 2) -34359738368)
   (check-equal? (mdl-session-call seeded "RANDOM") -34359738368)
   (check-equal? (mdl-session-call seeded "RANDOM" 1 2) -34359738368)
   (check-equal? (mdl-session-call seeded "RANDOM" 2 1) 2)
   (define one-seed (fresh))
   (check-equal? (mdl-session-call one-seed "RANDOM" 1) -27022051036)
   (check-equal? (mdl-session-call one-seed "RANDOM") -27022051036)
   (check-equal? (mdl-session-call one-seed "RANDOM" 1) -13511025517)
   (define zero (fresh))
   (check-equal? (mdl-session-call zero "RANDOM" 0 0) 0)
   (check-equal? (mdl-session-call zero "RANDOM") 0)
   (define negative (fresh))
   (check-equal? (mdl-session-call negative "RANDOM" -1 -2) 0)
   (check-equal? (mdl-session-call negative "RANDOM") 34359738367)
   (define edge (fresh))
   (check-equal? (mdl-session-call edge "RANDOM" 34359738367 -34359738368)
                 -17179869185)
   (check-equal? (mdl-session-call edge "RANDOM") 0)
   (define independent-a (fresh))
   (define independent-b (fresh))
   (check-equal? (mdl-session-call independent-a "RANDOM")
                 (mdl-session-call independent-b "RANDOM"))
   (mdl-session-call independent-a "RANDOM" 2 1)
   (check-equal? (mdl-session-call independent-b "RANDOM") -5008989035)
   (for ([bad (in-list (list "bad" 1.0 34359738368 -34359738369))])
     (check-exn #rx"RANDOM|FIX" (lambda () (mdl-session-call (fresh) "RANDOM" bad)))
     (check-exn #rx"RANDOM|FIX" (lambda () (mdl-session-call (fresh) "RANDOM" 1 bad))))
   (check-exn #rx"RANDOM|argument" (lambda ()
     (mdl-session-call (fresh) "RANDOM" 1 2 3)))
   (for ([seed-a (in-list '(-34359738368 -1 0 1 34359738367))]
         [seed-b (in-list '(34359738367 1 0 -1 -34359738368))])
     (define sample (fresh))
     (mdl-session-call sample "RANDOM" seed-a seed-b)
     (for ([i (in-range 100)])
       (define value (mdl-session-call sample "RANDOM"))
       (check-true (<= -34359738368 value 34359738367)))))
 (lambda () (delete-directory/files root)))
