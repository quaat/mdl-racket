#lang racket/base
(require rackunit "../mdl/parser.rkt" "../mdl/compiler.rkt"
         "../mdl/runtime/core.rkt")

(define-namespace-anchor anchor)
(define test-namespace (namespace-anchor->namespace anchor))
(define (run source)
  (parameterize ([current-namespace test-namespace]
                 [current-mdl-globals (make-hasheq)]
                 [current-mdl-locals (list (make-hasheq))]
                 [current-mdl-atom-space (make-mdl-atom-space)])
    (for/fold ([result #f]) ([expr (in-list (compile-program (parse-mdl source)))])
      (eval expr))))
(define (name source) (mdl-atom-pname (run source)))

(check-equal? (run "34359738367") 34359738367)
(check-equal? (run "-34359738368") -34359738368)
(check-equal? (name "<TYPE 34359738368>") "FLOAT")
(check-equal? (name "<TYPE *777777777777*>") "FLOAT")
(check-equal? (run "*10*") 8)
(check-equal? (run "10.") 10)
(check-equal? (mdl-word-bits (run "#WORD 0")) 0)
(check-equal? (name "<TYPEPRIM BITS>") "WORD")
(check-equal? (run "<+ 2 4 6>") 12)
(check-equal? (run "<- 5 3 2>") 0)
(check-equal? (run "<* 3 4>") 12)
(check-equal? (run "</ 11 7>") 1)
(check-equal? (run "</ -11 7>") -1)
(check-equal? (run "<MOD -11 7>") 3)
(check-equal? (run "<+>") 0)
(check-equal? (run "<->") 0)
(check-equal? (run "<*>") 1)
(check-equal? (run "</>") 1)
(check-equal? (run "</ 11 7 2.0>") 0.5)
(check-equal? (name "<TYPE <+ 1 2.0>>") "FLOAT")
(check-exn #rx"FIX overflow" (lambda () (run "<+ 34359738367 1>")))
(check-exn #rx"FIX overflow" (lambda () (run "<* 34359738367 2>")))
(check-exn #rx"division by zero" (lambda () (run "</ 1 0>")))
(check-equal? (name "<==? 10000000000 10000000000>") "T")
(check-true (mdl-false? (run "<==? 1 1.0>")))

(check-equal? (name "<TYPE #WORD *777777777777*>") "WORD")
(check-equal? (run "<CHTYPE #WORD *777777777777* FIX>") -1)
(check-equal? (run "<CHTYPE <CHTYPE -1 WORD> FIX>") -1)
(check-equal? (mdl-word-bits (run "<ANDB 7 3>")) 3)
(check-equal? (mdl-word-bits (run "<ORB 1 2>")) 3)
(check-equal? (mdl-word-bits (run "<XORB 7 3>")) 4)
(check-equal? (mdl-word-bits (run "<EQVB 1 1>")) (sub1 (expt 2 36)))
(check-equal? (mdl-word-bits (run "<ANDB>")) (sub1 (expt 2 36)))
(check-equal? (mdl-word-bits (run "<ORB>")) 0)
(check-equal? (mdl-word-bits (run "<XORB>")) 0)
(check-equal? (mdl-word-bits (run "<EQVB>")) (sub1 (expt 2 36)))
(check-equal? (mdl-word-bits (run "<LSH 8 6>")) 512)
(check-equal? (mdl-word-bits (run "<LSH 8 -6>")) 0)
(check-equal? (mdl-word-bits (run "<LSH 1 256>")) 1)
(check-equal? (mdl-word-bits (run "<GETBITS *012345670123* <BITS 6 18>>")) 37)
(check-equal? (mdl-word-bits (run "<PUTBITS #WORD *777777777777* <BITS 6 3>>"))
              (- (sub1 (expt 2 36)) (arithmetic-shift 63 3)))
(check-equal? (name "<==? <CHTYPE 8 WORD> <CHTYPE 8 WORD>>") "T")
(check-exn exn:fail? (lambda () (run "<ANDB 1.0 3>")))
(check-exn exn:fail? (lambda () (run "<BITS 37>")))
(check-exn exn:fail? (lambda () (run "<ROT 1 1>")))

(for ([n (in-range 0 36)])
  (define word (mdl-apply (mdl-atom "LSH") 1 n))
  (check-equal? (mdl-word-bits word) (arithmetic-shift 1 n)))
(displayln "36-bit FIX and WORD tests passed")
