    {"name": "on-off-user", "expression": "<OFF <ON \"M3-USER\" ,TYPE 7>>"},
    {"name": "on-invalid-action", "expression": "<ON \"IPC\" 1 1>"},
    {"name": "on-invalid-name", "expression": "<ON 1 ,TYPE 1>"},
    {"name": "on-zero-priority", "expression": "<ON \"IPC\" ,TYPE 0>"},
    {"name": "on-string-priority", "expression": "<ON \"IPC\" ,TYPE \"X\">"},
    {"name": "on-too-few", "expression": "<ON \"IPC\" ,TYPE>"},
    {"name": "on-too-many", "expression": "<ON \"IPC\" ,TYPE 1 2 3 4>"},
    {"name": "event-ipc-type", "expression": "<TYPE <EVENT \"IPC\" 1>>"},
    {"name": "handler-ipc-type", "expression": "<TYPE <HANDLER <EVENT \"IPC\" 1> ,TYPE>>"},
