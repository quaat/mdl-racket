    {"name": "save-string", "expression": "<SAVE \"S4PROBE.SAVE\">"},
    {"name": "save-type", "expression": "<TYPE <SAVE \"S4PROBE2.SAVE\">>"},
    {"name": "save-no-args", "expression": "<SAVE>"},
