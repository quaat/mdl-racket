    {
     "label": "A",
     "entry": "bare",
     "epoch": 250776000,
     "tz": "UTC",
     "commands": [
      "<SETG MARK 42>",
      "<RANDOM 12345 67890>",
      "<SAVE \"R.SAVE\">",
      "<RANDOM>",
      "<RANDOM>",
      "<RANDOM>",
      "<QUIT>"
     ]
    },
    {
     "label": "B",
     "entry": "bare",
     "epoch": 250776000,
     "tz": "UTC",
     "commands": [
      "<SETG MARK 7>",
      "<RANDOM 1 2>",
      "<RANDOM>",
      "<RESTORE \"R.SAVE\">",
      ",MARK",
      "<RANDOM>",
      "<RANDOM>",
      "<RANDOM>",
      "<QUIT>"
     ]
    },
    {
     "label": "C-control",
     "entry": "bare",
     "epoch": 250776000,
     "tz": "UTC",
     "commands": [
      "<RANDOM 1 2>",
      "<RANDOM>",
      "<RANDOM>",
      "<RANDOM>",
      "<RANDOM>",
      "<QUIT>"
     ]
    }
   ],
   "setup": [
    "remove SAVEFILE/ZORK.SAVE"
   ],
   "diagnostic_twin": false,
   "note": "A seeds and saves, then draws 3. B seeds differently, draws 1, restores A's image (MARK shows the heap came back), draws 3. C is B's sequence without a restore. If RANDOM were in the image, B's last 3 = A's 3; otherwise B's last 3 = C's draws 2-4."
